<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Practice Questions | Student Portal</title>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="stylesheet" href="/css/main.css">
    <style>
        .practice-card {
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 24px;
            margin-bottom: 20px;
            box-shadow: var(--shadow-sm);
            transition: all var(--transition-fast);
        }

        .practice-card:hover {
            border-color: #CBD5E1;
        }

        .practice-opt {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-md);
            margin-bottom: 8px;
            cursor: pointer;
            transition: all var(--transition-fast);
            background: #FFFFFF;
        }

        .practice-opt:hover {
            background: #F8FAFC;
        }

        .practice-opt.selected {
            border-color: var(--primary);
            background: var(--primary-light);
            font-weight: 600;
        }

        .practice-opt.correct {
            border-color: var(--success);
            background: #DCFCE7;
            color: #15803D;
            font-weight: 600;
        }

        .practice-opt.incorrect {
            border-color: var(--danger);
            background: #FEE2E2;
            color: #991B1B;
            font-weight: 600;
        }

        .solution-box {
            display: none;
            margin-top: 14px;
            padding: 14px 18px;
            background: #F8FAFC;
            border-radius: var(--radius-md);
            border: 1px solid var(--border-color);
            font-size: 0.92rem;
        }
    </style>
</head>

<body>

    <div class="app-container">
        <!-- Top Navbar -->
        <header class="app-navbar">
            <div class="brand-wrapper">
                <div class="brand-icon">
                    <span class="material-icons">school</span>
                </div>
                <div class="brand-title">Student Portal</div>
            </div>
            <div class="nav-actions">
                <a href="/student" class="btn btn-outline btn-sm">
                    <span class="material-icons" style="font-size: 16px;">dashboard</span>
                    <span>Dashboard</span>
                </a>
                <a href="/student/logout" class="btn btn-outline btn-sm">
                    <span class="material-icons" style="font-size: 16px;">logout</span>
                    <span>Sign Out</span>
                </a>
            </div>
        </header>

        <div class="app-body">
            <!-- Sidebar -->
            <nav class="app-sidebar">
                <div class="sidebar-heading">Navigation</div>
                <a href="/student" class="sidebar-item">
                    <span class="material-icons">dashboard</span>
                    <span>Dashboard</span>
                </a>
                <a href="/student/exams" class="sidebar-item">
                    <span class="material-icons">assignment_turned_in</span>
                    <span>Exams</span>
                </a>
                <a href="/student/create-exam" class="sidebar-item">
                    <span class="material-icons">add_task</span>
                    <span>Practice Exam</span>
                </a>
                <a href="/student/questions" class="sidebar-item active">
                    <span class="material-icons">menu_book</span>
                    <span>Question Practice</span>
                </a>
                <a href="/student/assignments" class="sidebar-item">
                    <span class="material-icons">assignment</span>
                    <span>Assignments</span>
                </a>
                <a href="/student/profile" class="sidebar-item">
                    <span class="material-icons">person</span>
                    <span>My Profile</span>
                </a>
            </nav>

            <main class="app-main" style="max-width: 900px; margin: 0 auto; width: 100%;">
                <div class="page-header">
                    <div>
                        <h1 class="page-title">
                            <span class="material-icons" style="font-size: 32px; color: var(--primary);">menu_book</span>
                            Interactive Question Practice
                        </h1>
                        <p class="page-subtitle">Test your skills without time limits. Pick an answer and check the solution instantly.</p>
                    </div>
                </div>

                <% (questioncollections || []).forEach((q, idx) => { %>
                    <div class="practice-card" id="qcard-<%= q.QUESTION_ID %>" data-correct="<%= q.CORRECT_ANSWER %>">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                            <span style="font-size: 0.82rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">
                                Question <%= idx + 1 %>
                            </span>
                            <span class="badge" style="background: #F1F5F9; color: var(--text-muted);">
                                <%= q.TYPE_NAME || 'MCQ' %>
                            </span>
                        </div>

                        <div style="font-size: 1.1rem; font-weight: 600; color: var(--text-main); margin-bottom: 16px;">
                            <%= q.QUESTION_BODY %>
                        </div>

                        <div class="options-container">
                            <% [q.OPTION_1, q.OPTION_2, q.OPTION_3, q.OPTION_4].forEach(opt => { %>
                                <% if (opt && opt.trim()) { %>
                                    <div class="practice-opt" onclick="selectPracticeOption(this, '<%= q.QUESTION_ID %>')">
                                        <input type="radio" name="opt_<%= q.QUESTION_ID %>" value="<%= opt %>" style="accent-color: var(--primary);">
                                        <span><%= opt %></span>
                                    </div>
                                <% } %>
                            <% }); %>
                        </div>

                        <div style="display: flex; gap: 10px; margin-top: 14px;">
                            <button type="button" class="btn btn-primary btn-sm" onclick="checkAnswer('<%= q.QUESTION_ID %>')">
                                <span class="material-icons" style="font-size: 16px;">check</span>
                                <span>Verify Answer</span>
                            </button>
                            <button type="button" class="btn btn-outline btn-sm" onclick="revealAnswer('<%= q.QUESTION_ID %>')">
                                <span class="material-icons" style="font-size: 16px;">visibility</span>
                                <span>Show Solution</span>
                            </button>
                        </div>

                        <div class="solution-box" id="sol-<%= q.QUESTION_ID %>">
                            <strong>Correct Solution:</strong> <span class="sol-text" style="color: #15803D; font-weight: 600;"><%= q.CORRECT_ANSWER %></span>
                        </div>
                    </div>
                <% }); %>
            </main>
        </div>
    </div>

    <script>
        function selectPracticeOption(el, qid) {
            const card = document.getElementById('qcard-' + qid);
            card.querySelectorAll('.practice-opt').forEach(opt => {
                opt.classList.remove('selected');
                const radio = opt.querySelector('input[type="radio"]');
                if (radio) radio.checked = false;
            });
            el.classList.add('selected');
            const radio = el.querySelector('input[type="radio"]');
            if (radio) radio.checked = true;
        }

        function checkAnswer(qid) {
            const card = document.getElementById('qcard-' + qid);
            const correct = card.getAttribute('data-correct');
            const selectedOpt = card.querySelector('.practice-opt.selected');

            if (!selectedOpt) {
                alert('Please select an option first!');
                return;
            }

            const chosenVal = selectedOpt.querySelector('input').value;
            const solBox = document.getElementById('sol-' + qid);
            solBox.style.display = 'block';

            card.querySelectorAll('.practice-opt').forEach(opt => {
                const val = opt.querySelector('input').value;
                if (val === correct) {
                    opt.classList.add('correct');
                } else if (opt === selectedOpt && val !== correct) {
                    opt.classList.add('incorrect');
                }
            });
        }

        function revealAnswer(qid) {
            const solBox = document.getElementById('sol-' + qid);
            solBox.style.display = 'block';
            const card = document.getElementById('qcard-' + qid);
            const correct = card.getAttribute('data-correct');
            card.querySelectorAll('.practice-opt').forEach(opt => {
                if (opt.querySelector('input').value === correct) {
                    opt.classList.add('correct');
                }
            });
        }
    </script>
</body>

</html>
