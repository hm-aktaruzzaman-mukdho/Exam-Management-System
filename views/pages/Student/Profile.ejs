<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Student Profile | Exam Management System</title>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="stylesheet" href="/css/main.css">
    <style>
        .profile-container {
            max-width: 760px;
            margin: 0 auto;
        }

        .profile-avatar-hero {
            display: flex;
            align-items: center;
            gap: 20px;
            padding-bottom: 24px;
            border-bottom: 1px solid var(--border-color);
            margin-bottom: 24px;
        }

        .profile-avatar-large {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            background: var(--primary-gradient);
            color: #FFFFFF;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            font-weight: 800;
            box-shadow: 0 4px 14px rgba(79, 70, 229, 0.3);
        }

        .info-pill-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 14px;
            margin-bottom: 28px;
        }

        .info-pill {
            background: #F8FAFC;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-md);
            padding: 12px 16px;
        }

        .info-pill-label {
            font-size: 0.78rem;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
        }

        .info-pill-value {
            font-size: 1rem;
            font-weight: 700;
            color: var(--text-main);
            margin-top: 2px;
        }
    </style>
</head>

<body>

    <div class="app-container">
        <!-- Top Navbar -->
        <header class="app-navbar">
            <div class="brand-wrapper">
                <div class="brand-icon">
                    <span class="material-icons">school</span>
                </div>
                <div class="brand-title">Student Portal</div>
            </div>
            <div class="nav-actions">
                <a href="/student" class="btn btn-outline btn-sm">
                    <span class="material-icons" style="font-size: 16px;">dashboard</span>
                    <span>Dashboard</span>
                </a>
                <a href="/student/logout" class="btn btn-outline btn-sm">
                    <span class="material-icons" style="font-size: 16px;">logout</span>
                    <span>Sign Out</span>
                </a>
            </div>
        </header>

        <div class="app-body">
            <!-- Sidebar -->
            <nav class="app-sidebar">
                <div class="sidebar-heading">Navigation</div>
                <a href="/student" class="sidebar-item">
                    <span class="material-icons">dashboard</span>
                    <span>Dashboard</span>
                </a>
                <a href="/student/exams" class="sidebar-item">
                    <span class="material-icons">assignment_turned_in</span>
                    <span>Exams</span>
                </a>
                <a href="/student/create-exam" class="sidebar-item">
                    <span class="material-icons">add_task</span>
                    <span>Practice Exam</span>
                </a>
                <a href="/student/questions" class="sidebar-item">
                    <span class="material-icons">menu_book</span>
                    <span>Question Practice</span>
                </a>
                <a href="/student/assignments" class="sidebar-item">
                    <span class="material-icons">assignment</span>
                    <span>Assignments</span>
                </a>
                <a href="/student/profile" class="sidebar-item active">
                    <span class="material-icons">person</span>
                    <span>My Profile</span>
                </a>
            </nav>

            <main class="app-main">
                <div class="profile-container">
                    <div class="page-header">
                        <div>
                            <h1 class="page-title">
                                <span class="material-icons" style="font-size: 32px; color: var(--primary);">account_circle</span>
                                Student Profile & Settings
                            </h1>
                            <p class="page-subtitle">Manage your personal credentials and view account details</p>
                        </div>
                    </div>

                    <% const s = (student && student.length > 0) ? student[0] : {}; %>

                    <div class="card">
                        <div class="profile-avatar-hero">
                            <div class="profile-avatar-large">
                                <%= (s.FIRST_NAME || 'S').charAt(0).toUpperCase() %>
                            </div>
                            <div>
                                <h2 style="font-size: 1.5rem;"><%= s.FIRST_NAME %> <%= s.LAST_NAME %></h2>
                                <p style="color: var(--text-muted); font-size: 0.92rem;"><%= s.EMAIL %></p>
                                <span class="user-role-pill" style="margin-top: 6px; display: inline-block;">Enrolled Student</span>
                            </div>
                        </div>

                        <!-- Readonly Info Pills -->
                        <div class="info-pill-grid">
                            <div class="info-pill">
                                <div class="info-pill-label">Student ID</div>
                                <div class="info-pill-value">#<%= s.STUDENT_ID %></div>
                            </div>
                            <div class="info-pill">
                                <div class="info-pill-label">Academic Level</div>
                                <div class="info-pill-value"><%= s.LEVEL_NAME %></div>
                            </div>
                            <div class="info-pill">
                                <div class="info-pill-label">Age</div>
                                <div class="info-pill-value"><%= s.AGE %> Years</div>
                            </div>
                            <div class="info-pill">
                                <div class="info-pill-label">Member Since</div>
                                <div class="info-pill-value"><%= s.REGISTERED_DATE ? new Date(s.REGISTERED_DATE).toLocaleDateString() : 'N/A' %></div>
                            </div>
                        </div>

                        <!-- Edit Form -->
                        <h2 style="font-size: 1.2rem; margin-bottom: 16px;">Update Name & Credentials</h2>
                        <form id="editForm" onsubmit="handleProfileUpdate(event)">
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                                <div class="form-group">
                                    <label class="form-label" for="firstName">First Name</label>
                                    <input type="text" id="firstName" name="firstName" class="form-control" value="<%= s.FIRST_NAME %>" required>
                                </div>
                                <div class="form-group">
                                    <label class="form-label" for="lastName">Last Name</label>
                                    <input type="text" id="lastName" name="lastName" class="form-control" value="<%= s.LAST_NAME %>" required>
                                </div>
                            </div>

                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                                <div class="form-group">
                                    <label class="form-label" for="password">New Password</label>
                                    <input type="password" id="password" name="password" class="form-control" placeholder="Leave blank to keep unchanged">
                                </div>
                                <div class="form-group">
                                    <label class="form-label" for="confirmPassword">Confirm Password</label>
                                    <input type="password" id="confirmPassword" name="confirmPassword" class="form-control" placeholder="Repeat new password">
                                    <div id="passwordMismatchError" style="display: none; color: #DC2626; font-size: 0.8rem; margin-top: 4px;">Passwords do not match</div>
                                </div>
                            </div>

                            <button type="submit" id="saveBtn" class="btn btn-primary" style="margin-top: 8px;">
                                <span class="material-icons" style="font-size: 18px;">save</span>
                                <span>Save Changes</span>
                            </button>
                        </form>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <script>
        async function handleProfileUpdate(e) {
            e.preventDefault();
            const firstName = document.getElementById('firstName').value.trim();
            const lastName = document.getElementById('lastName').value.trim();
            const password = document.getElementById('password').value;
            const confirmPassword = document.getElementById('confirmPassword').value;
            const errorDiv = document.getElementById('passwordMismatchError');

            errorDiv.style.display = 'none';

            if (password && password !== confirmPassword) {
                errorDiv.style.display = 'block';
                return;
            }

            const btn = document.getElementById('saveBtn');
            btn.disabled = true;
            btn.innerHTML = 'Saving...';

            try {
                const payload = { firstName, lastName };
                if (password) {
                    payload.password = password;
                }

                const res = await fetch('/student/update-profile', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (res.ok) {
                    alert('Profile updated successfully!');
                    window.location.reload();
                } else {
                    alert('Failed to update profile.');
                }
            } catch (err) {
                console.error(err);
                alert('Network error updating profile.');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<span>Save Changes</span>';
            }
        }
    </script>
</body>

</html>
