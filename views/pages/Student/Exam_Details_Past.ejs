<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Exam Performance & Review | Student Portal</title>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="stylesheet" href="/css/main.css">
    <style>
        .result-header-card {
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 30px;
            margin-bottom: 28px;
            box-shadow: var(--shadow-sm);
        }

        .score-hero {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 20px;
            padding-bottom: 24px;
            border-bottom: 1px solid var(--border-color);
            margin-bottom: 24px;
        }

        .score-circle {
            background: var(--primary-light);
            border: 2px solid #C7D2FE;
            border-radius: var(--radius-lg);
            padding: 16px 28px;
            text-align: center;
        }

        .score-number {
            font-family: 'Outfit', sans-serif;
            font-size: 2.2rem;
            font-weight: 800;
            color: var(--primary);
            line-height: 1;
        }

        .score-label {
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-top: 4px;
        }

        .meta-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 16px;
            font-size: 0.9rem;
        }

        .meta-item {
            color: var(--text-muted);
        }

        .meta-item strong {
            color: var(--text-main);
            display: block;
            margin-bottom: 2px;
        }

        .answer-card {
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 24px;
            margin-bottom: 20px;
            box-shadow: var(--shadow-sm);
        }

        .answer-card.is-correct {
            border-left: 5px solid var(--success);
            background: #FAFCF8;
        }

        .answer-card.is-wrong {
            border-left: 5px solid var(--danger);
            background: #FCF8F8;
        }

        .answer-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-top: 16px;
            padding-top: 16px;
            border-top: 1px dashed var(--border-color);
        }

        @media (max-width: 600px) {
            .answer-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

    <div class="app-container">
        <!-- Top Navbar -->
        <header class="app-navbar">
            <div class="brand-wrapper">
                <div class="brand-icon">
                    <span class="material-icons">grade</span>
                </div>
                <div class="brand-title">Assessment Results</div>
            </div>
            <div class="nav-actions">
                <a href="/student/exams" class="btn btn-outline btn-sm">
                    <span class="material-icons" style="font-size: 16px;">arrow_back</span>
                    <span>All Exams</span>
                </a>
            </div>
        </header>

        <div class="app-body">
            <main class="app-main" style="max-width: 960px; margin: 0 auto; width: 100%;">
                <% if (examdetail && examdetail.length > 0) { %>
                    <% const exam = examdetail[0]; %>
                    
                    <div class="result-header-card">
                        <div class="score-hero">
                            <div>
                                <h1 style="font-size: 1.8rem; margin-bottom: 6px;"><%= exam.EXAM_TYPE || 'Standard Examination' %></h1>
                                <p style="color: var(--text-muted); font-size: 0.95rem;">Assessment ID #<%= exam.EXAM_ID %> &bull; Scheduled by <%= exam.FIRST_NAME || 'Faculty' %></p>
                            </div>
                            <div class="score-circle">
                                <div class="score-number"><%= exam.OBTAINED_MARKS != null ? exam.OBTAINED_MARKS : '0' %> <span style="font-size: 1.2rem; color: var(--text-light);">/ <%= exam.TOTAL_MARKS %></span></div>
                                <div class="score-label">Final Score</div>
                            </div>
                        </div>

                        <div class="meta-grid">
                            <div class="meta-item">
                                <strong>Instructor</strong>
                                <%= exam.FIRST_NAME %> (<%= exam.EMAIL %>)
                            </div>
                            <div class="meta-item">
                                <strong>Exam Date</strong>
                                <%= new Date(exam.EXAM_TIME).toLocaleString() %>
                            </div>
                            <div class="meta-item">
                                <strong>Duration</strong>
                                <%= exam.EXAM_DURATION %> Minutes
                            </div>
                            <div class="meta-item">
                                <strong>Academic Level</strong>
                                <%= exam.LEVEL_NAME %>
                            </div>
                        </div>

                        <% if (exam.FEEDBACK) { %>
                            <div style="margin-top: 20px; padding: 14px 18px; background: #EEF2FF; border-radius: var(--radius-md); border: 1px solid #C7D2FE;">
                                <strong style="color: #4338CA; display: block; margin-bottom: 4px;">Instructor Feedback:</strong>
                                <p style="color: #312E81; font-size: 0.95rem;"><%= exam.FEEDBACK %></p>
                            </div>
                        <% } %>

                        <!-- Review Submission Box -->
                        <div style="margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--border-color);">
                            <label class="form-label" for="review">Student Comments & Review</label>
                            <textarea id="review" class="form-control" rows="3" placeholder="Share your feedback on this exam..."></textarea>
                            <button id="submitReviewBtn" type="button" class="btn btn-secondary btn-sm" style="margin-top: 10px;" onclick="submitReview('<%= exam.EXAM_ID %>')">
                                <span class="material-icons" style="font-size: 16px;">comment</span>
                                <span>Submit Review</span>
                            </button>
                        </div>
                    </div>
                <% } %>

                <h2 style="font-size: 1.35rem; margin-bottom: 20px;">Question Breakdown & Solutions</h2>

                <!-- Question Answers List -->
                <% (examAnswers || []).forEach((answer, index) => { %>
                    <% const isCorrect = answer.IS_CORRECT == 1; %>
                    <div class="answer-card <%= isCorrect ? 'is-correct' : 'is-wrong' %>">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                            <span style="font-weight: 700; color: var(--text-muted); font-size: 0.85rem;">QUESTION <%= index + 1 %></span>
                            <% if (isCorrect) { %>
                                <span class="badge" style="background: #DCFCE7; color: #15803D;">
                                    <span class="material-icons" style="font-size: 16px;">check_circle</span>
                                    Correct (+<%= answer.OBTAINED_MARKS || answer.MARK_OF_QUESTION %> Marks)
                                </span>
                            <% } else { %>
                                <span class="badge" style="background: #FEE2E2; color: #991B1B;">
                                    <span class="material-icons" style="font-size: 16px;">cancel</span>
                                    Incorrect (0 Marks)
                                </span>
                            <% } %>
                        </div>

                        <div style="font-size: 1.05rem; font-weight: 600; color: var(--text-main); margin-bottom: 12px;">
                            <%= answer.QUESTION_BODY %>
                        </div>

                        <% if (answer.TYPE_NAME === 'MCQ') { %>
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 0.88rem; color: var(--text-muted); margin-bottom: 12px;">
                                <div>A: <%= answer.OPTION_1 %></div>
                                <div>B: <%= answer.OPTION_2 %></div>
                                <div>C: <%= answer.OPTION_3 %></div>
                                <div>D: <%= answer.OPTION_4 %></div>
                            </div>
                        <% } %>

                        <div class="answer-grid">
                            <div>
                                <span style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Your Submitted Answer</span>
                                <div style="font-weight: 600; font-size: 0.95rem; color: <%= isCorrect ? '#15803D' : '#991B1B' %>; margin-top: 4px;">
                                    <%= answer.GIVEN_ANSWER || 'No answer submitted' %>
                                </div>
                            </div>
                            <div>
                                <span style="font-size: 0.78rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Correct Solution</span>
                                <div style="font-weight: 600; font-size: 0.95rem; color: #15803D; margin-top: 4px;">
                                    <%= answer.CORRECT_ANSWER %>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </main>
        </div>
    </div>

    <script>
        async function submitReview(examId) {
            const reviewText = document.getElementById('review').value.trim();
            if (!reviewText) {
                alert('Please enter your review text before submitting.');
                return;
            }

            const btn = document.getElementById('submitReviewBtn');
            btn.disabled = true;

            try {
                const res = await fetch(`/student/exams/${examId}/review`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ review: reviewText })
                });
                if (res.ok) {
                    alert('Review submitted successfully!');
                    window.location.reload();
                } else {
                    alert('Failed to submit review.');
                }
            } catch (e) {
                console.error(e);
                alert('Network error submitting review.');
            } finally {
                btn.disabled = false;
            }
        }
    </script>
</body>

</html>
