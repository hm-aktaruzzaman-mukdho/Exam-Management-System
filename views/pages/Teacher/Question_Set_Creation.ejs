<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Question Set Builder | Teacher Portal</title>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="stylesheet" href="/css/main.css">
    <style>
        .builder-layout {
            display: grid;
            grid-template-columns: 280px 1fr;
            gap: 24px;
            align-items: start;
        }

        @media (max-width: 900px) {
            .builder-layout {
                grid-template-columns: 1fr;
            }
        }

        .topic-filter-card {
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 20px;
            box-shadow: var(--shadow-sm);
            max-height: calc(100vh - 200px);
            overflow-y: auto;
        }

        .topic-checkbox-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 10px;
            border-radius: var(--radius-sm);
            cursor: pointer;
            transition: background-color var(--transition-fast);
            font-size: 0.9rem;
            user-select: none;
        }

        .topic-checkbox-item:hover {
            background-color: #F8FAFC;
        }

        .topic-checkbox-item input {
            accent-color: var(--primary);
            width: 16px;
            height: 16px;
        }
    </style>
</head>

<body>

    <div class="app-container">
        <!-- Top Navbar -->
        <header class="app-navbar">
            <div class="brand-wrapper">
                <div class="brand-icon" style="background: var(--secondary-gradient);">
                    <span class="material-icons">psychology</span>
                </div>
                <div class="brand-title">Teacher Command Center</div>
            </div>
            <div class="nav-actions">
                <a href="/teacher" class="btn btn-outline btn-sm">
                    <span class="material-icons" style="font-size: 16px;">dashboard</span>
                    <span>Dashboard</span>
                </a>
                <a href="/teacher/logout" class="btn btn-outline btn-sm">
                    <span class="material-icons" style="font-size: 16px;">logout</span>
                    <span>Sign Out</span>
                </a>
            </div>
        </header>

        <div class="app-body">
            <!-- Sidebar -->
            <nav class="app-sidebar">
                <div class="sidebar-heading">Faculty Tools</div>
                <a href="/teacher" class="sidebar-item">
                    <span class="material-icons">dashboard</span>
                    <span>Dashboard</span>
                </a>
                <a href="/teacher/exams" class="sidebar-item">
                    <span class="material-icons">library_books</span>
                    <span>View Exams</span>
                </a>
                <a href="/teacher/create-exam" class="sidebar-item">
                    <span class="material-icons">playlist_add</span>
                    <span>Create Exam</span>
                </a>
                <a href="/teacher/question-creation" class="sidebar-item">
                    <span class="material-icons">add_circle_outline</span>
                    <span>Add Question</span>
                </a>
                <a href="/teacher/create-question-set" class="sidebar-item active">
                    <span class="material-icons">rule</span>
                    <span>Question Sets</span>
                </a>
                <a href="/teacher/assignments" class="sidebar-item">
                    <span class="material-icons">assignment</span>
                    <span>Assignments</span>
                </a>
                <a href="/teacher/modify-topic-subject" class="sidebar-item">
                    <span class="material-icons">category</span>
                    <span>Subjects & Topics</span>
                </a>
                <a href="/teacher/profile" class="sidebar-item">
                    <span class="material-icons">person</span>
                    <span>Faculty Profile</span>
                </a>
            </nav>

            <main class="app-main">
                <div class="page-header">
                    <div>
                        <h1 class="page-title">
                            <span class="material-icons" style="font-size: 32px; color: #0EA5E9;">rule</span>
                            Assemble Question Set
                        </h1>
                        <p class="page-subtitle">Filter by subject topic, pick questions, allocate marks, and save exam sets</p>
                    </div>
                </div>

                <!-- Set Naming & Save Header -->
                <div class="card" style="margin-bottom: 24px;">
                    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
                        <div style="flex: 1; min-width: 260px;">
                            <label class="form-label" for="questionSetName">Question Set Name</label>
                            <input id="questionSetName" type="text" class="form-control" placeholder="e.g. Midterm 2026 Question Paper A" required>
                        </div>

                        <div style="display: flex; align-items: center; gap: 16px;">
                            <div style="text-align: right;">
                                <div style="font-size: 0.8rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase;">Selected Items</div>
                                <div id="selectedCount" style="font-family: 'Outfit', sans-serif; font-size: 1.4rem; font-weight: 800; color: #0EA5E9;">0 Questions</div>
                            </div>

                            <button id="saveSetBtn" type="button" class="btn btn-primary" style="background: #0EA5E9;" onclick="saveQuestionSet()">
                                <span class="material-icons" style="font-size: 18px;">library_add_check</span>
                                <span>Save Question Set</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Builder Workspace -->
                <div class="builder-layout">
                    <!-- Left: Topic Selection Filter -->
                    <div class="topic-filter-card">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                            <strong style="font-size: 0.95rem;">Filter Topics</strong>
                            <button type="button" class="btn btn-outline btn-sm" onclick="selectAllTopics(true)" style="padding: 2px 8px; font-size: 0.75rem;">All</button>
                        </div>

                        <div style="display: flex; flex-direction: column; gap: 4px; margin-bottom: 16px;">
                            <% (topics || []).forEach(topic => { %>
                                <label class="topic-checkbox-item">
                                    <input type="checkbox" name="selectedTopics" value="<%= topic.TOPIC_NAME %>">
                                    <span><%= topic.TOPIC_NAME %></span>
                                </label>
                            <% }); %>
                        </div>

                        <button type="button" class="btn btn-secondary btn-sm" style="width: 100%;" onclick="filterQuestionsByTopic()">
                            <span class="material-icons" style="font-size: 16px;">search</span>
                            <span>Apply Topic Filter</span>
                        </button>
                    </div>

                    <!-- Right: Questions Table -->
                    <div class="table-card">
                        <div class="table-responsive">
                            <table class="data-table" id="questionsTable">
                                <thead>
                                    <tr>
                                        <th style="width: 48px; text-align: center;">Select</th>
                                        <th>Question Text & Options</th>
                                        <th style="width: 120px;">Marks Allocated</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (questions && questions.length > 0) { %>
                                        <% questions.forEach(q => { %>
                                            <tr data-question-id="<%= q.QUESTION_ID %>">
                                                <td style="text-align: center;">
                                                    <input type="checkbox" name="selectedQuestions" value="<%= q.QUESTION_ID %>" onchange="updateSelectedCounter()" style="accent-color: var(--primary); width: 18px; height: 18px; cursor: pointer;">
                                                </td>
                                                <td>
                                                    <div style="font-weight: 600; margin-bottom: 4px;"><%= q.QUESTION_BODY %></div>
                                                    <div style="font-size: 0.82rem; color: var(--text-muted);">
                                                        A: <%= q.OPTION_1 %> &bull; B: <%= q.OPTION_2 %> &bull; C: <%= q.OPTION_3 %> &bull; D: <%= q.OPTION_4 %>
                                                    </div>
                                                </td>
                                                <td>
                                                    <input type="number" name="marks" class="form-control" value="1" min="1" max="100" style="padding: 6px 10px; font-weight: 600;" required>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="3" style="text-align: center; padding: 36px; color: var(--text-muted);">
                                                No questions currently available. Select topics on the left to filter.
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <script>
        function selectAllTopics(check) {
            document.querySelectorAll('input[name="selectedTopics"]').forEach(cb => cb.checked = check);
        }

        function updateSelectedCounter() {
            const count = document.querySelectorAll('input[name="selectedQuestions"]:checked').length;
            document.getElementById('selectedCount').textContent = `${count} Questions`;
        }

        async function filterQuestionsByTopic() {
            const selected = [];
            document.querySelectorAll('input[name="selectedTopics"]:checked').forEach(cb => selected.push(cb.value));

            if (selected.length === 0) {
                alert('Please check at least one topic to filter questions.');
                return;
            }

            const url = `/teacher/search-questions-by-topic?selectedTopics=${encodeURIComponent(selected.join(','))}`;

            try {
                const res = await fetch(url, { headers: { 'Accept': 'application/json' } });
                if (!res.ok) throw new Error('Search failed');
                const questions = await res.json();

                const tbody = document.querySelector('#questionsTable tbody');
                tbody.innerHTML = '';

                if (!questions || questions.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="3" style="text-align: center; padding: 36px; color: var(--text-muted);">No questions found for the selected topics.</td></tr>';
                    updateSelectedCounter();
                    return;
                }

                questions.forEach(q => {
                    const tr = document.createElement('tr');
                    tr.setAttribute('data-question-id', q.QUESTION_ID);
                    tr.innerHTML = `
                        <td style="text-align: center;">
                            <input type="checkbox" name="selectedQuestions" value="${q.QUESTION_ID}" onchange="updateSelectedCounter()" style="accent-color: var(--primary); width: 18px; height: 18px; cursor: pointer;">
                        </td>
                        <td>
                            <div style="font-weight: 600; margin-bottom: 4px;">${q.QUESTION_BODY || ''}</div>
                            <div style="font-size: 0.82rem; color: var(--text-muted);">
                                A: ${q.OPTION_1 || ''} &bull; B: ${q.OPTION_2 || ''} &bull; C: ${q.OPTION_3 || ''} &bull; D: ${q.OPTION_4 || ''}
                            </div>
                        </td>
                        <td>
                            <input type="number" name="marks" class="form-control" value="1" min="1" max="100" style="padding: 6px 10px; font-weight: 600;" required>
                        </td>
                    `;
                    tbody.appendChild(tr);
                });
                updateSelectedCounter();
            } catch (err) {
                console.error(err);
                alert('Error searching questions by topic.');
            }
        }

        async function saveQuestionSet() {
            const setName = document.getElementById('questionSetName').value.trim();
            if (!setName) {
                alert('Please enter a Question Set Name.');
                document.getElementById('questionSetName').focus();
                return;
            }

            const checked = document.querySelectorAll('input[name="selectedQuestions"]:checked');
            if (checked.length === 0) {
                alert('Please select at least one question to include in this set.');
                return;
            }

            const selectedQuestions = [];
            checked.forEach(cb => {
                const tr = cb.closest('tr');
                const marksInput = tr.querySelector('input[name="marks"]');
                const mark = parseInt(marksInput ? marksInput.value : 1, 10);
                selectedQuestions.push({
                    questionId: parseInt(cb.value, 10),
                    mark: mark || 1
                });
            });

            const btn = document.getElementById('saveSetBtn');
            btn.disabled = true;
            btn.innerHTML = 'Saving Set...';

            try {
                const response = await fetch('/teacher/create-question-set', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        questionSetName: setName,
                        selectedQuestions: selectedQuestions
                    })
                });

                if (response.ok) {
                    alert('Question Set created successfully!');
                    window.location.reload();
                } else {
                    alert('Failed to save question set. Please try again.');
                }
            } catch (err) {
                console.error(err);
                alert('Network error saving question set.');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<span>Save Question Set</span>';
            }
        }
    </script>
</body>

</html>
