<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Question | Teacher Portal</title>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="stylesheet" href="/css/main.css">
</head>

<body>

    <div class="app-container">
        <!-- Top Navbar -->
        <header class="app-navbar">
            <div class="brand-wrapper">
                <div class="brand-icon" style="background: var(--secondary-gradient);">
                    <span class="material-icons">psychology</span>
                </div>
                <div class="brand-title">Teacher Command Center</div>
            </div>
            <div class="nav-actions">
                <a href="/teacher" class="btn btn-outline btn-sm">
                    <span class="material-icons" style="font-size: 16px;">dashboard</span>
                    <span>Dashboard</span>
                </a>
                <a href="/teacher/logout" class="btn btn-outline btn-sm">
                    <span class="material-icons" style="font-size: 16px;">logout</span>
                    <span>Sign Out</span>
                </a>
            </div>
        </header>

        <div class="app-body">
            <!-- Sidebar -->
            <nav class="app-sidebar">
                <div class="sidebar-heading">Faculty Tools</div>
                <a href="/teacher" class="sidebar-item">
                    <span class="material-icons">dashboard</span>
                    <span>Dashboard</span>
                </a>
                <a href="/teacher/exams" class="sidebar-item">
                    <span class="material-icons">library_books</span>
                    <span>View Exams</span>
                </a>
                <a href="/teacher/create-exam" class="sidebar-item">
                    <span class="material-icons">playlist_add</span>
                    <span>Create Exam</span>
                </a>
                <a href="/teacher/question-creation" class="sidebar-item active">
                    <span class="material-icons">add_circle_outline</span>
                    <span>Add Question</span>
                </a>
                <a href="/teacher/create-question-set" class="sidebar-item">
                    <span class="material-icons">rule</span>
                    <span>Question Sets</span>
                </a>
                <a href="/teacher/assignments" class="sidebar-item">
                    <span class="material-icons">assignment</span>
                    <span>Assignments</span>
                </a>
                <a href="/teacher/modify-topic-subject" class="sidebar-item">
                    <span class="material-icons">category</span>
                    <span>Subjects & Topics</span>
                </a>
                <a href="/teacher/profile" class="sidebar-item">
                    <span class="material-icons">person</span>
                    <span>Faculty Profile</span>
                </a>
            </nav>

            <main class="app-main">
                <div class="page-header">
                    <div>
                        <h1 class="page-title">
                            <span class="material-icons" style="font-size: 32px; color: #0EA5E9;">add_circle_outline</span>
                            Add New Question to Bank
                        </h1>
                        <p class="page-subtitle">Enrich the central question pool with multiple choice, true/false, or descriptive questions</p>
                    </div>
                </div>

                <div class="card" style="max-width: 800px;">
                    <form id="questionForm" onsubmit="createQuestion(event)">
                        <div class="form-group">
                            <label class="form-label" for="questionType">Question Format</label>
                            <select id="questionType" class="form-control" onchange="updateForm()" required>
                                <% (question_types || []).forEach(type => { %>
                                    <option value="<%= type.TYPE_NAME %>"><%= type.TYPE_DESCRIPTION || type.TYPE_NAME %></option>
                                <% }); %>
                            </select>
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="questionBody">Question Prompt / Statement</label>
                            <textarea id="questionBody" class="form-control" rows="3" placeholder="Enter full question text here..." required></textarea>
                        </div>

                        <div id="optionsContainer" style="margin-bottom: 20px;">
                            <!-- Dynamic Options Generated Here -->
                        </div>

                        <div class="form-group" id="correctAnswerGroup">
                            <label class="form-label" for="correctAnswer">Correct Answer</label>
                            <input id="correctAnswer" type="text" class="form-control" placeholder="Specify expected correct answer value" required>
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                            <div class="form-group">
                                <label class="form-label" for="academicLevel">Academic Level</label>
                                <select id="academicLevel" class="form-control" required>
                                    <% (academicLevels || []).forEach(level => { %>
                                        <option value="<%= level.LEVEL_NAME %>"><%= level.LEVEL_NAME %></option>
                                    <% }); %>
                                </select>
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="topicName">Subject Topic</label>
                                <select id="topicName" class="form-control" required>
                                    <% (topics || []).forEach(topic => { %>
                                        <option value="<%= topic.TOPIC_NAME %>"><%= topic.TOPIC_NAME %></option>
                                    <% }); %>
                                </select>
                            </div>
                        </div>

                        <button id="submitBtn" type="submit" class="btn btn-primary" style="width: 100%; margin-top: 10px; background: #0EA5E9;">
                            <span class="material-icons" style="font-size: 18px;">save</span>
                            <span>Save Question to Repository</span>
                        </button>
                    </form>
                </div>
            </main>
        </div>
    </div>

    <script>
        function updateForm() {
            const type = document.getElementById('questionType').value;
            const container = document.getElementById('optionsContainer');
            container.innerHTML = '';

            if (type === 'MCQ') {
                container.innerHTML = `
                    <label class="form-label">Multiple Choice Options</label>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                        <input id="option1" type="text" class="form-control" placeholder="Option A" required>
                        <input id="option2" type="text" class="form-control" placeholder="Option B" required>
                        <input id="option3" type="text" class="form-control" placeholder="Option C" required>
                        <input id="option4" type="text" class="form-control" placeholder="Option D" required>
                    </div>
                `;
            } else if (type === 'TF') {
                container.innerHTML = `
                    <div class="form-group">
                        <label class="form-label">Select Correct Boolean Value</label>
                        <select id="tfCorrect" class="form-control" onchange="document.getElementById('correctAnswer').value = this.value">
                            <option value="True">True</option>
                            <option value="False">False</option>
                        </select>
                    </div>
                `;
                document.getElementById('correctAnswer').value = 'True';
            }
        }

        updateForm();

        async function createQuestion(e) {
            e.preventDefault();
            const questionType = document.getElementById('questionType').value;
            const questionBody = document.getElementById('questionBody').value.trim();
            const correctAnswer = document.getElementById('correctAnswer').value.trim();
            const academicLevel = document.getElementById('academicLevel').value;
            const selectedTopic = document.getElementById('topicName').value;

            let options = [];
            if (questionType === 'MCQ') {
                options = [
                    document.getElementById('option1').value.trim(),
                    document.getElementById('option2').value.trim(),
                    document.getElementById('option3').value.trim(),
                    document.getElementById('option4').value.trim()
                ];
            } else if (questionType === 'TF') {
                options = ['True', 'False'];
            }

            const btn = document.getElementById('submitBtn');
            btn.disabled = true;
            btn.innerHTML = 'Saving Question...';

            try {
                const response = await fetch('/teacher/create-question', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        questionType,
                        questionBody,
                        options,
                        correctAnswer,
                        academicLevel,
                        selectedTopic
                    })
                });

                if (response.ok) {
                    alert('Question created successfully in question bank!');
                    window.location.reload();
                } else {
                    alert('Failed to save question. Please check all fields.');
                }
            } catch (err) {
                console.error(err);
                alert('Network error saving question.');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<span>Save Question to Repository</span>';
            }
        }
    </script>
</body>

</html>
