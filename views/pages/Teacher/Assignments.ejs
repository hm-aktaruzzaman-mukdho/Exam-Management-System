<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Assignments | Teacher Portal</title>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="stylesheet" href="/css/main.css">
    <style>
        .tab-pane {
            display: none;
            animation: fadeIn 0.2s ease;
        }

        .tab-pane.active {
            display: block;
        }
    </style>
</head>

<body>

    <div class="app-container">
        <!-- Top Navbar -->
        <header class="app-navbar">
            <div class="brand-wrapper">
                <div class="brand-icon" style="background: var(--secondary-gradient);">
                    <span class="material-icons">psychology</span>
                </div>
                <div class="brand-title">Teacher Command Center</div>
            </div>
            <div class="nav-actions">
                <a href="/teacher" class="btn btn-outline btn-sm">
                    <span class="material-icons" style="font-size: 16px;">dashboard</span>
                    <span>Dashboard</span>
                </a>
                <a href="/teacher/logout" class="btn btn-outline btn-sm">
                    <span class="material-icons" style="font-size: 16px;">logout</span>
                    <span>Sign Out</span>
                </a>
            </div>
        </header>

        <div class="app-body">
            <!-- Sidebar -->
            <nav class="app-sidebar">
                <div class="sidebar-heading">Faculty Tools</div>
                <a href="/teacher" class="sidebar-item">
                    <span class="material-icons">dashboard</span>
                    <span>Dashboard</span>
                </a>
                <a href="/teacher/exams" class="sidebar-item">
                    <span class="material-icons">library_books</span>
                    <span>View Exams</span>
                </a>
                <a href="/teacher/create-exam" class="sidebar-item">
                    <span class="material-icons">playlist_add</span>
                    <span>Create Exam</span>
                </a>
                <a href="/teacher/question-creation" class="sidebar-item">
                    <span class="material-icons">add_circle_outline</span>
                    <span>Add Question</span>
                </a>
                <a href="/teacher/create-question-set" class="sidebar-item">
                    <span class="material-icons">rule</span>
                    <span>Question Sets</span>
                </a>
                <a href="/teacher/assignments" class="sidebar-item active">
                    <span class="material-icons">assignment</span>
                    <span>Assignments</span>
                </a>
                <a href="/teacher/create-assignment" class="sidebar-item">
                    <span class="material-icons">add_to_queue</span>
                    <span>Create Assignment</span>
                </a>
                <a href="/teacher/modify-topic-subject" class="sidebar-item">
                    <span class="material-icons">category</span>
                    <span>Subjects & Topics</span>
                </a>
                <a href="/teacher/profile" class="sidebar-item">
                    <span class="material-icons">person</span>
                    <span>Faculty Profile</span>
                </a>
            </nav>

            <main class="app-main">
                <div class="page-header">
                    <div>
                        <h1 class="page-title">
                            <span class="material-icons" style="font-size: 32px; color: #0EA5E9;">assignment</span>
                            Coursework & Assignments
                        </h1>
                        <p class="page-subtitle">Publish homework prompts, track student submissions, and submit marks</p>
                    </div>
                    <div>
                        <a href="/teacher/create-assignment" class="btn btn-primary" style="background: var(--secondary-gradient);">
                            <span class="material-icons" style="font-size: 18px;">add</span>
                            <span>Create Assignment</span>
                        </a>
                    </div>
                </div>

                <%
                    const now = new Date();
                    let activeCount = 0;
                    let pastCount = 0;

                    (assignments || []).forEach(a => {
                        const dl = new Date(a.SUBMISSION_DEADLINE);
                        if (now <= dl) activeCount++;
                        else pastCount++;
                    });
                %>

                <div class="tab-bar">
                    <button class="tab-btn active" onclick="switchTab('active')">
                        Active Assignments (<%= activeCount %>)
                    </button>
                    <button class="tab-btn" onclick="switchTab('past')">
                        Past Deadlines (<%= pastCount %>)
                    </button>
                </div>

                <!-- Active Pane -->
                <div id="pane-active" class="tab-pane active">
                    <div class="table-card">
                        <div class="table-responsive">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Assignment Title</th>
                                        <th>Topic</th>
                                        <th>Level</th>
                                        <th>Total Marks</th>
                                        <th>Deadline</th>
                                        <th>Time Remaining</th>
                                        <th style="text-align: right;">Manage</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% let hasActive = false; %>
                                    <% (assignments || []).forEach(a => { %>
                                        <% const dl = new Date(a.SUBMISSION_DEADLINE); %>
                                        <% if (now <= dl) { %>
                                            <% hasActive = true; %>
                                            <tr>
                                                <td><strong>#<%= a.ASSIGNMENT_ID %></strong></td>
                                                <td>
                                                    <div style="font-weight: 600;"><%= a.ASSIGNMENT_NAME %></div>
                                                </td>
                                                <td><span class="badge" style="background: #F1F5F9; color: var(--text-muted);"><%= a.TOPIC_NAME %></span></td>
                                                <td><%= a.LEVEL_NAME %></td>
                                                <td><span class="badge" style="background: #EEF2FF; color: var(--primary);"><%= a.TOTAL_MARKS %> Pts</span></td>
                                                <td><%= dl.toLocaleString() %></td>
                                                <td id="teacher-time-<%= a.ASSIGNMENT_ID %>" style="font-weight: 600; color: #B45309;">Calculating...</td>
                                                <td style="text-align: right;">
                                                    <a href="/teacher/assignments/<%= a.ASSIGNMENT_ID %>" class="btn btn-outline btn-sm">
                                                        <span>Submissions & Grade</span>
                                                        <span class="material-icons" style="font-size: 16px;">edit</span>
                                                    </a>
                                                </td>
                                            </tr>
                                        <% } %>
                                    <% }); %>
                                    <% if (!hasActive) { %>
                                        <tr>
                                            <td colspan="8" style="text-align: center; padding: 36px; color: var(--text-muted);">
                                                No active assignments currently in session.
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Past Pane -->
                <div id="pane-past" class="tab-pane">
                    <div class="table-card">
                        <div class="table-responsive">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Assignment Title</th>
                                        <th>Topic</th>
                                        <th>Level</th>
                                        <th>Total Marks</th>
                                        <th>Concluded On</th>
                                        <th style="text-align: right;">Manage</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% let hasPast = false; %>
                                    <% (assignments || []).forEach(a => { %>
                                        <% const dl = new Date(a.SUBMISSION_DEADLINE); %>
                                        <% if (now > dl) { %>
                                            <% hasPast = true; %>
                                            <tr>
                                                <td><strong>#<%= a.ASSIGNMENT_ID %></strong></td>
                                                <td>
                                                    <div style="font-weight: 600;"><%= a.ASSIGNMENT_NAME %></div>
                                                </td>
                                                <td><span class="badge" style="background: #F1F5F9; color: var(--text-muted);"><%= a.TOPIC_NAME %></span></td>
                                                <td><%= a.LEVEL_NAME %></td>
                                                <td><span class="badge" style="background: #F1F5F9; color: var(--text-muted);"><%= a.TOTAL_MARKS %> Pts</span></td>
                                                <td><%= dl.toLocaleDateString() %></td>
                                                <td style="text-align: right;">
                                                    <a href="/teacher/assignments/<%= a.ASSIGNMENT_ID %>" class="btn btn-outline btn-sm">
                                                        <span>Submissions & Grade</span>
                                                        <span class="material-icons" style="font-size: 16px;">edit</span>
                                                    </a>
                                                </td>
                                            </tr>
                                        <% } %>
                                    <% }); %>
                                    <% if (!hasPast) { %>
                                        <tr>
                                            <td colspan="7" style="text-align: center; padding: 36px; color: var(--text-muted);">
                                                No past assignments found.
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <script>
        function switchTab(key) {
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));

            const targetBtn = Array.from(document.querySelectorAll('.tab-btn')).find(b => b.textContent.toLowerCase().includes(key));
            if (targetBtn) targetBtn.classList.add('active');

            const targetPane = document.getElementById('pane-' + key);
            if (targetPane) targetPane.classList.add('active');
        }

        function formatDuration(diffSeconds) {
            if (diffSeconds <= 0) return "Closed";
            const days = Math.floor(diffSeconds / 86400);
            const hours = Math.floor((diffSeconds % 86400) / 3600);
            const minutes = Math.floor((diffSeconds % 3600) / 60);

            if (days > 0) return `${days}d ${hours}h left`;
            if (hours > 0) return `${hours}h ${minutes}m left`;
            return `${minutes}m left`;
        }

        function updateDeadlines() {
            const now = new Date();
            <% (assignments || []).forEach(a => { %>
                (function() {
                    const dl = new Date('<%= a.SUBMISSION_DEADLINE %>');
                    const el = document.getElementById('teacher-time-<%= a.ASSIGNMENT_ID %>');
                    if (el) {
                        const diff = (dl - now) / 1000;
                        el.textContent = formatDuration(diff);
                    }
                })();
            <% }); %>
        }

        setInterval(updateDeadlines, 1000);
        updateDeadlines();
    </script>
</body>

</html>
