<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Assignment | Teacher Portal</title>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="stylesheet" href="/css/main.css">
</head>

<body>

    <div class="app-container">
        <!-- Top Navbar -->
        <header class="app-navbar">
            <div class="brand-wrapper">
                <div class="brand-icon" style="background: var(--secondary-gradient);">
                    <span class="material-icons">psychology</span>
                </div>
                <div class="brand-title">Teacher Command Center</div>
            </div>
            <div class="nav-actions">
                <a href="/teacher" class="btn btn-outline btn-sm">
                    <span class="material-icons" style="font-size: 16px;">dashboard</span>
                    <span>Dashboard</span>
                </a>
                <a href="/teacher/logout" class="btn btn-outline btn-sm">
                    <span class="material-icons" style="font-size: 16px;">logout</span>
                    <span>Sign Out</span>
                </a>
            </div>
        </header>

        <div class="app-body">
            <!-- Sidebar -->
            <nav class="app-sidebar">
                <div class="sidebar-heading">Faculty Tools</div>
                <a href="/teacher" class="sidebar-item">
                    <span class="material-icons">dashboard</span>
                    <span>Dashboard</span>
                </a>
                <a href="/teacher/exams" class="sidebar-item">
                    <span class="material-icons">library_books</span>
                    <span>View Exams</span>
                </a>
                <a href="/teacher/create-exam" class="sidebar-item">
                    <span class="material-icons">playlist_add</span>
                    <span>Create Exam</span>
                </a>
                <a href="/teacher/question-creation" class="sidebar-item">
                    <span class="material-icons">add_circle_outline</span>
                    <span>Add Question</span>
                </a>
                <a href="/teacher/create-question-set" class="sidebar-item">
                    <span class="material-icons">rule</span>
                    <span>Question Sets</span>
                </a>
                <a href="/teacher/assignments" class="sidebar-item">
                    <span class="material-icons">assignment</span>
                    <span>Assignments</span>
                </a>
                <a href="/teacher/create-assignment" class="sidebar-item active">
                    <span class="material-icons">add_to_queue</span>
                    <span>Create Assignment</span>
                </a>
                <a href="/teacher/modify-topic-subject" class="sidebar-item">
                    <span class="material-icons">category</span>
                    <span>Subjects & Topics</span>
                </a>
                <a href="/teacher/profile" class="sidebar-item">
                    <span class="material-icons">person</span>
                    <span>Faculty Profile</span>
                </a>
            </nav>

            <main class="app-main">
                <div class="page-header">
                    <div>
                        <h1 class="page-title">
                            <span class="material-icons" style="font-size: 32px; color: #0EA5E9;">add_to_queue</span>
                            Publish Homework Assignment
                        </h1>
                        <p class="page-subtitle">Assign research tasks, case studies, or programming problems to your students</p>
                    </div>
                </div>

                <div class="card" style="max-width: 720px;">
                    <form action="/teacher/create-assignment" method="POST">
                        <div class="form-group">
                            <label class="form-label" for="assignmentName">Assignment Title</label>
                            <input type="text" id="assignmentName" name="assignmentName" class="form-control" placeholder="e.g. Relational Database Design Project" required>
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                            <div class="form-group">
                                <label class="form-label" for="topicName">Course Topic</label>
                                <select id="topicName" name="topicName" class="form-control" required>
                                    <% (topics || []).forEach(topic => { %>
                                        <option value="<%= topic.TOPIC_NAME %>"><%= topic.TOPIC_NAME %></option>
                                    <% }); %>
                                </select>
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="levelName">Academic Level</label>
                                <select id="levelName" name="levelName" class="form-control" required>
                                    <% (academicLevels || []).forEach(level => { %>
                                        <option value="<%= level.LEVEL_NAME %>"><%= level.LEVEL_NAME %></option>
                                    <% }); %>
                                </select>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="assignmentDetails">Project Requirements & Guidelines</label>
                            <textarea id="assignmentDetails" name="assignmentDetails" class="form-control" rows="4" placeholder="Detail the expected deliverables, constraints, and submission criteria..." required></textarea>
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                            <div class="form-group">
                                <label class="form-label" for="submissionDeadline">Submission Deadline</label>
                                <input type="datetime-local" id="submissionDeadline" name="submissionDeadline" class="form-control" required>
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="totalMarks">Maximum Marks</label>
                                <input type="number" id="totalMarks" name="totalMarks" class="form-control" value="100" min="10" max="500" required>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 10px; background: #0EA5E9;">
                            <span class="material-icons" style="font-size: 18px;">publish</span>
                            <span>Publish Assignment</span>
                        </button>
                    </form>
                </div>
            </main>
        </div>
    </div>

    <script>
        const deadline = new Date();
        deadline.setDate(deadline.getDate() + 7);
        deadline.setHours(23, 59, 0, 0);
        const iso = deadline.toISOString().slice(0, 16);
        const deadlineInput = document.getElementById('submissionDeadline');
        if (deadlineInput) {
            deadlineInput.value = iso;
        }
    </script>
</body>

</html>
