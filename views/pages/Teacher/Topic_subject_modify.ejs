<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Curriculum Management | Teacher Portal</title>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="stylesheet" href="/css/main.css">
    <style>
        .grid-2col {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
        }

        @media (max-width: 800px) {
            .grid-2col {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

    <div class="app-container">
        <!-- Top Navbar -->
        <header class="app-navbar">
            <div class="brand-wrapper">
                <div class="brand-icon" style="background: var(--secondary-gradient);">
                    <span class="material-icons">psychology</span>
                </div>
                <div class="brand-title">Teacher Command Center</div>
            </div>
            <div class="nav-actions">
                <a href="/teacher" class="btn btn-outline btn-sm">
                    <span class="material-icons" style="font-size: 16px;">dashboard</span>
                    <span>Dashboard</span>
                </a>
                <a href="/teacher/logout" class="btn btn-outline btn-sm">
                    <span class="material-icons" style="font-size: 16px;">logout</span>
                    <span>Sign Out</span>
                </a>
            </div>
        </header>

        <div class="app-body">
            <!-- Sidebar -->
            <nav class="app-sidebar">
                <div class="sidebar-heading">Faculty Tools</div>
                <a href="/teacher" class="sidebar-item">
                    <span class="material-icons">dashboard</span>
                    <span>Dashboard</span>
                </a>
                <a href="/teacher/exams" class="sidebar-item">
                    <span class="material-icons">library_books</span>
                    <span>View Exams</span>
                </a>
                <a href="/teacher/create-exam" class="sidebar-item">
                    <span class="material-icons">playlist_add</span>
                    <span>Create Exam</span>
                </a>
                <a href="/teacher/question-creation" class="sidebar-item">
                    <span class="material-icons">add_circle_outline</span>
                    <span>Add Question</span>
                </a>
                <a href="/teacher/create-question-set" class="sidebar-item">
                    <span class="material-icons">rule</span>
                    <span>Question Sets</span>
                </a>
                <a href="/teacher/assignments" class="sidebar-item">
                    <span class="material-icons">assignment</span>
                    <span>Assignments</span>
                </a>
                <a href="/teacher/create-assignment" class="sidebar-item">
                    <span class="material-icons">add_to_queue</span>
                    <span>Create Assignment</span>
                </a>
                <a href="/teacher/modify-topic-subject" class="sidebar-item active">
                    <span class="material-icons">category</span>
                    <span>Subjects & Topics</span>
                </a>
                <a href="/teacher/profile" class="sidebar-item">
                    <span class="material-icons">person</span>
                    <span>Faculty Profile</span>
                </a>
            </nav>

            <main class="app-main">
                <div class="page-header">
                    <div>
                        <h1 class="page-title">
                            <span class="material-icons" style="font-size: 32px; color: #0EA5E9;">category</span>
                            Curriculum & Course Management
                        </h1>
                        <p class="page-subtitle">Add new academic disciplines, manage course syllabus topics, or prune obsolete units</p>
                    </div>
                </div>

                <!-- Add Section -->
                <h2 style="font-size: 1.3rem; margin-bottom: 16px;">Add to Curriculum</h2>
                <div class="grid-2col" style="margin-bottom: 36px;">
                    <!-- Create Subject -->
                    <div class="card">
                        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 14px;">
                            <span class="material-icons" style="color: var(--primary);">library_books</span>
                            <h3 class="card-title" style="margin-bottom: 0;">New Subject</h3>
                        </div>
                        <form action="/teacher/create-subject" method="POST">
                            <div class="form-group">
                                <label class="form-label" for="subjectName">Subject Name</label>
                                <input type="text" id="subjectName" name="subjectName" class="form-control" placeholder="e.g. Distributed Databases" required>
                            </div>
                            <div class="form-group">
                                <label class="form-label" for="subjectDescription">Subject Description</label>
                                <textarea id="subjectDescription" name="subjectDescription" class="form-control" rows="3" placeholder="Brief overview of course curriculum..." required></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary" style="width: 100%;">
                                <span class="material-icons" style="font-size: 18px;">add</span>
                                <span>Create Subject</span>
                            </button>
                        </form>
                    </div>

                    <!-- Create Topic -->
                    <div class="card">
                        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 14px;">
                            <span class="material-icons" style="color: #0EA5E9;">topic</span>
                            <h3 class="card-title" style="margin-bottom: 0;">New Syllabus Topic</h3>
                        </div>
                        <form action="/teacher/create-topic" method="POST">
                            <div class="form-group">
                                <label class="form-label" for="topicName">Topic Title</label>
                                <input type="text" id="topicName" name="topicName" class="form-control" placeholder="e.g. Concurrency Control" required>
                            </div>
                            <div class="form-group">
                                <label class="form-label" for="subjectNameSelect">Parent Subject</label>
                                <select id="subjectNameSelect" name="subjectName" class="form-control" required>
                                    <% (subjects || []).forEach(s => { %>
                                        <option value="<%= s.SUBJECT_NAME %>"><%= s.SUBJECT_NAME %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <div class="form-group">
                                <label class="form-label" for="topicDescription">Topic Description</label>
                                <textarea id="topicDescription" name="topicDescription" class="form-control" rows="3" placeholder="Module topics and key themes..." required></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary" style="width: 100%; background: #0EA5E9;">
                                <span class="material-icons" style="font-size: 18px;">add</span>
                                <span>Create Topic</span>
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Danger Zone: Deletions -->
                <h2 style="font-size: 1.3rem; margin-bottom: 16px; color: #DC2626;">Danger Zone: Remove Curriculum Items</h2>
                <div class="grid-2col">
                    <!-- Delete Topic -->
                    <div class="card" style="border-color: #FECACA;">
                        <h3 class="card-title" style="color: #991B1B;">Remove Topic</h3>
                        <form action="/teacher/delete-topic" method="POST" onsubmit="return confirm('Are you sure you want to delete this topic and all attached references?');">
                            <div class="form-group">
                                <label class="form-label" for="topicToDelete">Select Topic</label>
                                <select id="topicToDelete" name="topicToDelete" class="form-control" required>
                                    <% (topics || []).forEach(t => { %>
                                        <option value="<%= t.TOPIC_NAME %>"><%= t.TOPIC_NAME %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <button type="submit" class="btn btn-danger" style="width: 100%;">
                                <span class="material-icons" style="font-size: 18px;">delete</span>
                                <span>Delete Selected Topic</span>
                            </button>
                        </form>
                    </div>

                    <!-- Delete Subject -->
                    <div class="card" style="border-color: #FECACA;">
                        <h3 class="card-title" style="color: #991B1B;">Remove Subject</h3>
                        <form action="/teacher/delete-subject" method="POST" onsubmit="return confirm('Deleting a subject will cascade or require all linked topics to be cleared first. Proceed?');">
                            <div class="form-group">
                                <label class="form-label" for="subjectToDelete">Select Subject</label>
                                <select id="subjectToDelete" name="subjectToDelete" class="form-control" required>
                                    <% (subjects || []).forEach(s => { %>
                                        <option value="<%= s.SUBJECT_NAME %>"><%= s.SUBJECT_NAME %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <button type="submit" class="btn btn-danger" style="width: 100%;">
                                <span class="material-icons" style="font-size: 18px;">delete_forever</span>
                                <span>Delete Selected Subject</span>
                            </button>
                        </form>
                    </div>
                </div>
            </main>
        </div>
    </div>

</body>

</html>
