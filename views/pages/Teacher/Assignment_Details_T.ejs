<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Assignment Management & Grading | Teacher Portal</title>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="stylesheet" href="/css/main.css">
</head>

<body>

    <div class="app-container">
        <!-- Top Navbar -->
        <header class="app-navbar">
            <div class="brand-wrapper">
                <div class="brand-icon" style="background: var(--secondary-gradient);">
                    <span class="material-icons">psychology</span>
                </div>
                <div class="brand-title">Teacher Command Center</div>
            </div>
            <div class="nav-actions">
                <a href="/teacher/assignments" class="btn btn-outline btn-sm">
                    <span class="material-icons" style="font-size: 16px;">arrow_back</span>
                    <span>All Assignments</span>
                </a>
            </div>
        </header>

        <div class="app-body">
            <!-- Sidebar -->
            <nav class="app-sidebar">
                <div class="sidebar-heading">Faculty Tools</div>
                <a href="/teacher" class="sidebar-item">
                    <span class="material-icons">dashboard</span>
                    <span>Dashboard</span>
                </a>
                <a href="/teacher/exams" class="sidebar-item">
                    <span class="material-icons">library_books</span>
                    <span>View Exams</span>
                </a>
                <a href="/teacher/create-exam" class="sidebar-item">
                    <span class="material-icons">playlist_add</span>
                    <span>Create Exam</span>
                </a>
                <a href="/teacher/question-creation" class="sidebar-item">
                    <span class="material-icons">add_circle_outline</span>
                    <span>Add Question</span>
                </a>
                <a href="/teacher/create-question-set" class="sidebar-item">
                    <span class="material-icons">rule</span>
                    <span>Question Sets</span>
                </a>
                <a href="/teacher/assignments" class="sidebar-item active">
                    <span class="material-icons">assignment</span>
                    <span>Assignments</span>
                </a>
                <a href="/teacher/create-assignment" class="sidebar-item">
                    <span class="material-icons">add_to_queue</span>
                    <span>Create Assignment</span>
                </a>
                <a href="/teacher/modify-topic-subject" class="sidebar-item">
                    <span class="material-icons">category</span>
                    <span>Subjects & Topics</span>
                </a>
                <a href="/teacher/profile" class="sidebar-item">
                    <span class="material-icons">person</span>
                    <span>Faculty Profile</span>
                </a>
            </nav>

            <main class="app-main" style="max-width: 960px; margin: 0 auto; width: 100%;">
                <% if (assignments && assignments.length > 0) { %>
                    <% const a = assignments[0]; %>
                    <div class="card" style="margin-bottom: 24px;">
                        <div style="display: flex; justify-content: space-between; align-items: start; flex-wrap: wrap; gap: 16px; margin-bottom: 16px;">
                            <div>
                                <span class="badge" style="background: #E0F2FE; color: #0284C7; margin-bottom: 8px;">
                                    Assignment #<%= a.ASSIGNMENT_ID %>
                                </span>
                                <h1 style="font-size: 1.8rem;"><%= a.ASSIGNMENT_NAME %></h1>
                            </div>
                            <div>
                                <span class="badge" style="background: #EEF2FF; color: var(--primary); font-size: 1rem; padding: 6px 14px;">
                                    <%= a.TOTAL_MARKS %> Total Marks
                                </span>
                            </div>
                        </div>

                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; padding: 14px 0; border-top: 1px solid var(--border-color); border-bottom: 1px solid var(--border-color); margin-bottom: 20px;">
                            <div>
                                <span style="font-size: 0.8rem; color: var(--text-muted); display: block;">Topic</span>
                                <strong><%= a.TOPIC_NAME %></strong>
                            </div>
                            <div>
                                <span style="font-size: 0.8rem; color: var(--text-muted); display: block;">Academic Level</span>
                                <strong><%= a.LEVEL_NAME %></strong>
                            </div>
                            <div>
                                <span style="font-size: 0.8rem; color: var(--text-muted); display: block;">Deadline</span>
                                <strong><%= new Date(a.SUBMISSION_DEADLINE).toLocaleString() %></strong>
                            </div>
                        </div>

                        <% if (a.ASSIGNMENT_DETAILS) { %>
                            <p style="color: var(--text-muted); margin-bottom: 20px; line-height: 1.6;"><%= a.ASSIGNMENT_DETAILS %></p>
                        <% } %>

                        <!-- Action Bar: Download PDF & Upload Question PDF -->
                        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 14px; padding: 16px; background: #F8FAFC; border-radius: var(--radius-md);">
                            <a href="/teacher/assignments/<%= a.ASSIGNMENT_ID %>/download" class="btn btn-outline btn-sm">
                                <span class="material-icons" style="font-size: 16px;">download</span>
                                <span>Download Question File</span>
                            </a>

                            <form action="/teacher/assignments/<%= a.ASSIGNMENT_ID %>/upload-question" method="POST" enctype="multipart/form-data" style="display: flex; align-items: center; gap: 10px;">
                                <input type="file" name="assignmentQuestionPdf" accept=".pdf,.doc,.docx" required style="font-size: 0.85rem;">
                                <button type="submit" class="btn btn-primary btn-sm" style="background: #0EA5E9;">
                                    <span class="material-icons" style="font-size: 16px;">upload</span>
                                    <span>Upload Question PDF</span>
                                </button>
                            </form>
                        </div>
                    </div>

                    <!-- Update Assignment Form -->
                    <div class="card" style="margin-bottom: 28px;">
                        <h2 style="font-size: 1.2rem; margin-bottom: 14px;">Update Assignment Parameters</h2>
                        <form id="updateAssignmentForm" onsubmit="handleAssignmentUpdate(event, '<%= a.ASSIGNMENT_ID %>')">
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                                <div class="form-group">
                                    <label class="form-label" for="newDeadline">Extend Submission Deadline</label>
                                    <input id="newDeadline" type="datetime-local" class="form-control">
                                </div>
                                <div class="form-group">
                                    <label class="form-label" for="newMark">Update Total Marks</label>
                                    <input id="newMark" type="number" class="form-control" placeholder="<%= a.TOTAL_MARKS %>" min="1" max="500">
                                </div>
                            </div>
                            <button type="submit" class="btn btn-secondary btn-sm">
                                <span class="material-icons" style="font-size: 16px;">save</span>
                                <span>Save Changes</span>
                            </button>
                        </form>
                    </div>
                <% } %>

                <!-- Student Submissions -->
                <h2 style="font-size: 1.35rem; margin-bottom: 16px;">Student Submissions (<%= (submittedAssignments || []).length %>)</h2>

                <div class="table-card">
                    <div class="table-responsive">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Student ID</th>
                                    <th>Candidate Details</th>
                                    <th>Submission Time</th>
                                    <th>Answer File</th>
                                    <th style="width: 200px;">Assign Mark</th>
                                    <th style="text-align: right;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (submittedAssignments && submittedAssignments.length > 0) { %>
                                    <% submittedAssignments.forEach(sub => { %>
                                        <tr>
                                            <td><strong>#<%= sub.STUDENT_ID %></strong></td>
                                            <td>
                                                <div style="font-weight: 600;"><%= sub.FIRST_NAME ? `${sub.FIRST_NAME} ${sub.LAST_NAME || ''}` : `Student #${sub.STUDENT_ID}` %></div>
                                                <div style="font-size: 0.78rem; color: var(--text-muted);"><%= sub.EMAIL || '' %></div>
                                            </td>
                                            <td><%= sub.SUBMISSION_TIME ? new Date(sub.SUBMISSION_TIME).toLocaleString() : 'N/A' %></td>
                                            <td>
                                                <a href="/teacher/assignments/<%= sub.ASSIGNMENT_ID %>/students/<%= sub.STUDENT_ID %>/download" class="btn btn-outline btn-sm">
                                                    <span class="material-icons" style="font-size: 16px;">file_download</span>
                                                    <span>Download PDF</span>
                                                </a>
                                            </td>
                                            <td>
                                                <input type="number" id="mark_<%= sub.STUDENT_ID %>" class="form-control" value="<%= sub.MARKS_OBTAINED != null ? sub.MARKS_OBTAINED : '' %>" placeholder="e.g. 85" min="0" max="500" style="padding: 6px 10px; font-weight: 600;">
                                            </td>
                                            <td style="text-align: right;">
                                                <button type="button" class="btn btn-primary btn-sm" style="background: #0EA5E9;" onclick="submitStudentMark('<%= sub.ASSIGNMENT_ID %>', '<%= sub.STUDENT_ID %>')">
                                                    <span class="material-icons" style="font-size: 16px;">check</span>
                                                    <span>Grade</span>
                                                </button>
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="6" style="text-align: center; padding: 36px; color: var(--text-muted);">
                                            No student submissions received for this assignment yet.
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <script>
        async function handleAssignmentUpdate(e, aid) {
            e.preventDefault();
            const newDeadline = document.getElementById('newDeadline').value;
            const newMark = document.getElementById('newMark').value;

            if (!newDeadline && !newMark) {
                alert('Please enter a new deadline or new total marks.');
                return;
            }

            try {
                const res = await fetch(`/teacher/assignments/${aid}/update`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ newDeadline, newMark })
                });

                if (res.ok) {
                    alert('Assignment parameters updated successfully!');
                    window.location.reload();
                } else {
                    alert('Failed to update assignment.');
                }
            } catch (err) {
                console.error(err);
                alert('Network error updating assignment.');
            }
        }

        async function submitStudentMark(aid, studentId) {
            const markInput = document.getElementById('mark_' + studentId);
            const mark = markInput ? markInput.value : '';

            if (mark === '') {
                alert('Please enter a mark before submitting.');
                return;
            }

            try {
                const res = await fetch(`/teacher/assignments/${aid}/submit-mark`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ studentId, mark })
                });

                if (res.ok) {
                    alert('Student grade recorded successfully!');
                    window.location.reload();
                } else {
                    alert('Failed to save grade.');
                }
            } catch (err) {
                console.error(err);
                alert('Network error submitting mark.');
            }
        }
    </script>
</body>

</html>
