<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Teacher Command Center | Exam Management System</title>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="stylesheet" href="/css/main.css">
    <style>
        .action-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }

        .action-card {
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 24px;
            box-shadow: var(--shadow-sm);
            transition: all var(--transition-normal);
            cursor: pointer;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .action-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-lg);
            border-color: #CBD5E1;
        }

        .action-header {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 12px;
        }

        .action-icon {
            width: 46px;
            height: 46px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #FFF;
            font-size: 24px;
        }

        .action-title {
            font-size: 1.15rem;
            font-weight: 700;
        }

        .action-desc {
            font-size: 0.88rem;
            color: var(--text-muted);
            line-height: 1.5;
            margin-bottom: 16px;
        }
    </style>
</head>

<body>

    <div class="app-container">
        <!-- Top Navbar -->
        <header class="app-navbar">
            <div class="brand-wrapper">
                <div class="brand-icon" style="background: var(--secondary-gradient);">
                    <span class="material-icons">psychology</span>
                </div>
                <div>
                    <div class="brand-title">Teacher Command Center</div>
                </div>
            </div>
            <div class="nav-actions">
                <div class="user-badge">
                    <div class="user-avatar" style="background: #E0F2FE; color: #0284C7;">T</div>
                    <span style="font-weight: 600; font-size: 0.9rem;">Faculty Portal</span>
                    <span class="user-role-pill" style="background: #E0F2FE; color: #0284C7;">Teacher</span>
                </div>
                <% if (typeof user !== 'undefined' && user && user[0] && user[0].IS_ADMIN === 1) { %>
                <a href="/admin" class="btn btn-outline btn-sm" style="border-color: #DC2626; color: #DC2626;">
                    <span class="material-icons" style="font-size: 16px;">admin_panel_settings</span>
                    <span>Admin Console</span>
                </a>
                <% } %>
                <a href="/teacher/logout" class="btn btn-outline btn-sm">
                    <span class="material-icons" style="font-size: 16px;">logout</span>
                    <span>Sign Out</span>
                </a>
            </div>
        </header>

        <div class="app-body">
            <!-- Sidebar Navigation -->
            <nav class="app-sidebar">
                <div class="sidebar-heading">Faculty Tools</div>
                <a href="/teacher" class="sidebar-item active">
                    <span class="material-icons">dashboard</span>
                    <span>Dashboard</span>
                </a>
                <a href="/teacher/exams" class="sidebar-item">
                    <span class="material-icons">library_books</span>
                    <span>View Exams</span>
                </a>
                <a href="/teacher/create-exam" class="sidebar-item">
                    <span class="material-icons">playlist_add</span>
                    <span>Create Exam</span>
                </a>
                <a href="/teacher/question-creation" class="sidebar-item">
                    <span class="material-icons">add_circle_outline</span>
                    <span>Add Question</span>
                </a>
                <a href="/teacher/create-question-set" class="sidebar-item">
                    <span class="material-icons">rule</span>
                    <span>Question Sets</span>
                </a>
                <a href="/teacher/assignments" class="sidebar-item">
                    <span class="material-icons">assignment</span>
                    <span>Assignments</span>
                </a>
                <a href="/teacher/create-assignment" class="sidebar-item">
                    <span class="material-icons">add_to_queue</span>
                    <span>Create Assignment</span>
                </a>
                <a href="/teacher/modify-topic-subject" class="sidebar-item">
                    <span class="material-icons">category</span>
                    <span>Subjects & Topics</span>
                </a>
                <a href="/teacher/profile" class="sidebar-item">
                    <span class="material-icons">person</span>
                    <span>Faculty Profile</span>
                </a>
            </nav>

            <!-- Main Content Workspace -->
            <main class="app-main">
                <div class="page-header">
                    <div>
                        <h1 class="page-title">
                            <span class="material-icons" style="font-size: 32px; color: #0EA5E9;">tune</span>
                            Faculty Overview & Management
                        </h1>
                        <p class="page-subtitle">Schedule examinations, build comprehensive question sets, and grade submissions</p>
                    </div>
                    <div>
                        <a href="/teacher/create-exam" class="btn btn-primary" style="background: var(--secondary-gradient);">
                            <span class="material-icons" style="font-size: 18px;">add</span>
                            <span>Schedule Exam</span>
                        </a>
                    </div>
                </div>

                <!-- Stats Grid -->
                <div class="grid-stats">
                    <div class="stat-card" onclick="window.location.href='/teacher/exams'" style="cursor: pointer;">
                        <div class="stat-icon-wrapper stat-icon-secondary">
                            <span class="material-icons">library_books</span>
                        </div>
                        <div class="stat-info">
                            <div class="stat-value"><%= (typeof stats !== 'undefined' && stats.totalExams) || 0 %></div>
                            <div class="stat-label">Exams Created & Managed</div>
                        </div>
                    </div>

                    <div class="stat-card" onclick="window.location.href='/teacher/create-question-set'" style="cursor: pointer;">
                        <div class="stat-icon-wrapper stat-icon-primary">
                            <span class="material-icons">quiz</span>
                        </div>
                        <div class="stat-info">
                            <div class="stat-value"><%= (typeof stats !== 'undefined' && stats.totalQuestions) || 0 %></div>
                            <div class="stat-label">Active Questions (<%= (typeof stats !== 'undefined' && stats.totalQuestionSets) || 0 %> Sets)</div>
                        </div>
                    </div>

                    <div class="stat-card" onclick="window.location.href='/teacher/assignments'" style="cursor: pointer;">
                        <div class="stat-icon-wrapper stat-icon-warning">
                            <span class="material-icons">assignment</span>
                        </div>
                        <div class="stat-info">
                            <div class="stat-value"><%= (typeof stats !== 'undefined' && stats.pendingGrades) || 0 %></div>
                            <div class="stat-label">Submissions Awaiting Grading</div>
                        </div>
                    </div>

                    <div class="stat-card" onclick="window.location.href='/teacher/modify-topic-subject'" style="cursor: pointer;">
                        <div class="stat-icon-wrapper stat-icon-success">
                            <span class="material-icons">school</span>
                        </div>
                        <div class="stat-info">
                            <div class="stat-value"><%= (typeof stats !== 'undefined' && stats.totalStudents) || 0 %></div>
                            <div class="stat-label">Registered Student Scholars</div>
                        </div>
                    </div>
                </div>

                <!-- Quick Action Hub -->
                <div class="card">
                    <h2 class="card-title">Quick Action Hub</h2>
                    <p style="color: var(--text-muted); font-size: 0.92rem; margin-bottom: 20px;">Direct access to core academic operations</p>

                    <div class="action-grid">
                        <div class="action-card" onclick="window.location.href='/teacher/create-exam'">
                            <div>
                                <div class="action-header">
                                    <div class="action-icon" style="background: var(--secondary-gradient);">
                                        <span class="material-icons">playlist_add</span>
                                    </div>
                                    <div class="action-title">Create Exam</div>
                                </div>
                                <p class="action-desc">Configure exam duration, select academic level, attach a question set, and schedule launch time.</p>
                            </div>
                            <span class="btn btn-outline btn-sm" style="align-self: flex-start;">Launch Exam Builder &rarr;</span>
                        </div>

                        <div class="action-card" onclick="window.location.href='/teacher/question-creation'">
                            <div>
                                <div class="action-header">
                                    <div class="action-icon" style="background: var(--primary-gradient);">
                                        <span class="material-icons">add_circle_outline</span>
                                    </div>
                                    <div class="action-title">Add New Question</div>
                                </div>
                                <p class="action-desc">Enrich the central question repository with multiple choice, true/false, or written questions.</p>
                            </div>
                            <span class="btn btn-outline btn-sm" style="align-self: flex-start;">Add Questions &rarr;</span>
                        </div>

                        <div class="action-card" onclick="window.location.href='/teacher/create-question-set'">
                            <div>
                                <div class="action-header">
                                    <div class="action-icon" style="background: linear-gradient(135deg, #8B5CF6, #6D28D9);">
                                        <span class="material-icons">rule</span>
                                    </div>
                                    <div class="action-title">Create Question Set</div>
                                </div>
                                <p class="action-desc">Filter questions by topic, assign individual marks, and package into an exam-ready set.</p>
                            </div>
                            <span class="btn btn-outline btn-sm" style="align-self: flex-start;">Assemble Sets &rarr;</span>
                        </div>

                        <div class="action-card" onclick="window.location.href='/teacher/create-assignment'">
                            <div>
                                <div class="action-header">
                                    <div class="action-icon" style="background: linear-gradient(135deg, #F59E0B, #D97706);">
                                        <span class="material-icons">add_to_queue</span>
                                    </div>
                                    <div class="action-title">New Assignment</div>
                                </div>
                                <p class="action-desc">Publish homework tasks, attach prompt documents, set deadlines, and specify total marks.</p>
                            </div>
                            <span class="btn btn-outline btn-sm" style="align-self: flex-start;">New Assignment &rarr;</span>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

</body>

</html>
